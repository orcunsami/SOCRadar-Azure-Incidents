{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0",
    "metadata": {
        "title": "SOCRadar-Alarms-Infrastructure",
        "description": "NOT RECOMMENDED - deploy azuredeploy.json in the repository root instead, which creates this and wires the playbook permissions to it. Creates DCE, Custom Table and DCR for storing SOCRadar alarms in Log Analytics",
        "version": "1.0.0",
        "author": "SOCRadar",
        "lastUpdateTime": "2026-02-04T00:00:00.000Z"
    },
    "parameters": {
        "WorkspaceName": {
            "type": "string",
            "metadata": {
                "description": "NOT RECOMMENDED: deploy azuredeploy.json from the repository root instead. --- Microsoft Sentinel Log Analytics Workspace Name"
            }
        },
        "WorkspaceLocation": {
            "type": "string",
            "metadata": {
                "description": "Region of the Log Analytics workspace (e.g., centralus, northeurope). This is the region of the WORKSPACE, which can differ from the region of the resource group you deploy into; read it from the workspace Overview blade rather than assuming. A wrong value fails the deployment with LinkedResourceNotFound: Linked Workspace ... was not found in location <region>; if the workspace name is correct, that error means this parameter is wrong."
            }
        },
        "TableRetentionDays": {
            "type": "int",
            "defaultValue": 90,
            "minValue": 30,
            "maxValue": 730,
            "metadata": {
                "description": "Data retention in days (30-730)"
            }
        }
    },
    "variables": {
        "DceName": "SOCRadar-DCE",
        "AlarmsTableName": "SOCRadar_Alarms_CL",
        "AlarmsDcrName": "SOCRadar-Alarms-DCR",
        "AlarmsStreamName": "Custom-SOCRadar_Alarms_CL",
        "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Insights/dataCollectionEndpoints",
            "apiVersion": "2023-03-11",
            "name": "[variables('DceName')]",
            "location": "[parameters('WorkspaceLocation')]",
            "properties": {
                "description": "Data Collection Endpoint for SOCRadar integration",
                "networkAcls": {
                    "publicNetworkAccess": "Enabled"
                }
            }
        },
        {
            "type": "Microsoft.OperationalInsights/workspaces/tables",
            "apiVersion": "2022-10-01",
            "name": "[concat(parameters('WorkspaceName'), '/', variables('AlarmsTableName'))]",
            "properties": {
                "schema": {
                    "name": "[variables('AlarmsTableName')]",
                    "columns": [
                        {
                            "name": "TimeGenerated",
                            "type": "datetime",
                            "description": "Ingestion timestamp"
                        },
                        {
                            "name": "AlarmId",
                            "type": "string",
                            "description": "SOCRadar alarm ID"
                        },
                        {
                            "name": "CompanyId",
                            "type": "string",
                            "description": "SOCRadar company ID"
                        },
                        {
                            "name": "AlarmMainType",
                            "type": "string",
                            "description": "Main alarm category"
                        },
                        {
                            "name": "AlarmSubType",
                            "type": "string",
                            "description": "Alarm sub-category"
                        },
                        {
                            "name": "Severity",
                            "type": "string",
                            "description": "CRITICAL/HIGH/MEDIUM/LOW/INFO"
                        },
                        {
                            "name": "Status",
                            "type": "string",
                            "description": "Alarm status"
                        },
                        {
                            "name": "Title",
                            "type": "string",
                            "description": "Alarm title"
                        },
                        {
                            "name": "AlarmText",
                            "type": "string",
                            "description": "Alarm description (truncated to 4000 chars)"
                        },
                        {
                            "name": "AlarmDate",
                            "type": "string",
                            "description": "Original alarm date from SOCRadar"
                        },
                        {
                            "name": "AlarmPayload",
                            "type": "dynamic",
                            "description": "Full SOCRadar alarm JSON"
                        },
                        {
                            "name": "IoCIp1",
                            "type": "string",
                            "description": "First-3 IPv4 indicator extracted from the alarm (empty if none)"
                        },
                        {
                            "name": "IoCDomain1",
                            "type": "string",
                            "description": "First-3 domain indicator extracted from the alarm (empty if none)"
                        },
                        {
                            "name": "IoCUrl1",
                            "type": "string",
                            "description": "First-3 URL indicator extracted from the alarm (empty if none)"
                        }
                    ]
                },
                "retentionInDays": "[parameters('TableRetentionDays')]",
                "plan": "Analytics"
            }
        },
        {
            "type": "Microsoft.Insights/dataCollectionRules",
            "apiVersion": "2023-03-11",
            "name": "[variables('AlarmsDcrName')]",
            "location": "[parameters('WorkspaceLocation')]",
            "dependsOn": [
                "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('DceName'))]",
                "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('WorkspaceName'), variables('AlarmsTableName'))]"
            ],
            "properties": {
                "description": "DCR for SOCRadar alarms ingestion",
                "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('DceName'))]",
                "streamDeclarations": {
                    "[variables('AlarmsStreamName')]": {
                        "columns": [
                            {
                                "name": "TimeGenerated",
                                "type": "datetime"
                            },
                            {
                                "name": "AlarmId",
                                "type": "string"
                            },
                            {
                                "name": "CompanyId",
                                "type": "string"
                            },
                            {
                                "name": "AlarmMainType",
                                "type": "string"
                            },
                            {
                                "name": "AlarmSubType",
                                "type": "string"
                            },
                            {
                                "name": "Severity",
                                "type": "string"
                            },
                            {
                                "name": "Status",
                                "type": "string"
                            },
                            {
                                "name": "Title",
                                "type": "string"
                            },
                            {
                                "name": "AlarmText",
                                "type": "string"
                            },
                            {
                                "name": "AlarmDate",
                                "type": "string"
                            },
                            {
                                "name": "AlarmPayload",
                                "type": "dynamic"
                            },
                            {
                                "name": "IoCIp1",
                                "type": "string"
                            },
                            {
                                "name": "IoCDomain1",
                                "type": "string"
                            },
                            {
                                "name": "IoCUrl1",
                                "type": "string"
                            }
                        ]
                    }
                },
                "destinations": {
                    "logAnalytics": [
                        {
                            "workspaceResourceId": "[variables('workspaceResourceId')]",
                            "name": "workspace"
                        }
                    ]
                },
                "dataFlows": [
                    {
                        "streams": [
                            "[variables('AlarmsStreamName')]"
                        ],
                        "destinations": [
                            "workspace"
                        ],
                        "transformKql": "source | extend AlarmPayload = pack('alarm_id', AlarmPayload['alarm_id'], 'status', AlarmPayload['status'], 'alarm_risk_level', AlarmPayload['alarm_risk_level'], 'alarm_text', AlarmPayload['alarm_text'], 'alarm_type_details', AlarmPayload['alarm_type_details'], 'alarm_asset', AlarmPayload['alarm_asset'], 'date', AlarmPayload['date'], 'tags', AlarmPayload['tags'], 'compromised_domains', AlarmPayload['content']['compromised_domains'], 'compromised_ips', AlarmPayload['content']['compromised_ips'], 'malware_family', AlarmPayload['content']['malware_family'], 'malware_path', AlarmPayload['content']['malware_path'], 'phishing_domain', AlarmPayload['content']['phishing_domain'], 'ip_address', AlarmPayload['content']['ip_address'], 'score', AlarmPayload['content']['score'], 'phishing_keyword', AlarmPayload['content']['phishing_keyword'], 'computer_name', AlarmPayload['content']['computer_name'], 'device_ip', AlarmPayload['content']['device_ip'], 'country', AlarmPayload['content']['country'], 'asset_match', AlarmPayload['content']['asset_match'], 'content_link', AlarmPayload['content']['content_link'], 'source_link', AlarmPayload['content']['source_link'], 'repository_url', AlarmPayload['content']['repository_url'], 'source', AlarmPayload['content']['source'], 'attack_type', AlarmPayload['content']['attack_type'], 'matched_asset', AlarmPayload['content']['matched_asset'], 'domains', AlarmPayload['content']['domains'], 'cve_id', AlarmPayload['content']['cve_id'], 'cvss', AlarmPayload['content']['cvss'], 'affected_software', AlarmPayload['content']['affected_software'], 'related_entities', substring(tostring(AlarmPayload['alarm_related_entities']), 0, 4000), 'related_assets', substring(tostring(AlarmPayload['alarm_related_assets']), 0, 4000))",
                        "outputStream": "[variables('AlarmsStreamName')]"
                    }
                ]
            }
        }
    ],
    "outputs": {
        "dceName": {
            "type": "string",
            "value": "[variables('DceName')]"
        },
        "dceEndpoint": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('DceName')), '2023-03-11').logsIngestion.endpoint]"
        },
        "alarmsTableName": {
            "type": "string",
            "value": "[variables('AlarmsTableName')]"
        },
        "alarmsDcrName": {
            "type": "string",
            "value": "[variables('AlarmsDcrName')]"
        },
        "alarmsDcrId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Insights/dataCollectionRules', variables('AlarmsDcrName'))]"
        },
        "alarmsDcrImmutableId": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', variables('AlarmsDcrName')), '2023-03-11').immutableId]"
        },
        "alarmsStreamName": {
            "type": "string",
            "value": "[variables('AlarmsStreamName')]"
        }
    }
}