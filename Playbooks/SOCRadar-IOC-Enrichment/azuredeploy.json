{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0",
    "metadata": {
        "title": "SOCRadar-IOC-Enrichment",
        "description": "Enriches Microsoft Sentinel incident entities (IP, domain, URL, file hash) with SOCRadar IOC Enrichment intelligence (risk score, signal strength, categorization, threat actors). Triggers on incident creation, queries SOCRadar indicator_details API, and posts an enrichment comment to the incident. For SOCRadar-Alarm-Import incidents (which carry no Sentinel entities), it also fetches the original alarm's related entities from SOCRadar by alarm id, so real alarm incidents get enriched too. Handles not-found (404), async (202), and benign indicators gracefully.",
        "version": "1.1.0",
        "author": "SOCRadar",
        "lastUpdateTime": "2026-07-01T00:00:00.000Z"
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "SOCRadar-IOC-Enrichment",
            "metadata": {
                "description": "Name of the Logic App"
            }
        },
        "SocradarApiKey": {
            "type": "securestring",
            "metadata": {
                "description": "SOCRadar API Key (same key used by SOCRadar-Alarm-Import / SOCRadar-Alarm-Sync). Used here to fetch the original alarm's related entities. Also used for IOC enrichment if SocradarIocApiKey is left empty."
            }
        },
        "SocradarIocApiKey": {
            "type": "securestring",
            "defaultValue": "",
            "metadata": {
                "description": "Optional. Separate SOCRadar IOC Enrichment API key (Standard Licensed APIs / advanced tier). Leave empty to use SocradarApiKey for enrichment calls too."
            }
        },
        "CompanyId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "SOCRadar Company ID. Used to fetch the original alarm's related entities from SOCRadar for incidents created by SOCRadar-Alarm-Import (which carry no Sentinel entities). Leave empty to enrich only Sentinel-provided entities."
            }
        },
        "WorkspaceName": {
            "type": "string",
            "metadata": {
                "description": "Microsoft Sentinel Log Analytics Workspace Name"
            }
        },
        "WorkspaceResourceGroup": {
            "type": "string",
            "defaultValue": "[resourceGroup().name]",
            "metadata": {
                "description": "Resource group of existing Microsoft Sentinel workspace. Leave default if workspace is in same resource group."
            }
        },
        "RiskScoreThreshold": {
            "type": "int",
            "defaultValue": 0,
            "minValue": 0,
            "maxValue": 100,
            "metadata": {
                "description": "Only post an enrichment comment when the SOCRadar risk score is greater than or equal to this value. Default 0 = comment on every indicator that has signal (benign whitelisted indicators with score 0 are skipped to reduce noise)."
            }
        },
        "MaxIndicators": {
            "type": "int",
            "defaultValue": 20,
            "minValue": 1,
            "maxValue": 100,
            "metadata": {
                "description": "Maximum indicators enriched per incident. Each enrichment consumes one SOCRadar API credit."
            }
        },
        "SentinelServicePrincipalObjectId": {
            "type": "string",
            "defaultValue": "",
            "metadata": {
                "description": "Object ID of the Azure Security Insights service principal. Microsoft Sentinel needs Automation Contributor on this resource group to run the playbook. Leave empty to grant it later from Microsoft Sentinel > Settings > Playbook permissions."
            }
        },
        "SentinelRoleLevel": {
            "type": "string",
            "defaultValue": "Responder",
            "allowedValues": [
                "Contributor",
                "Responder"
            ],
            "metadata": {
                "description": "Microsoft Sentinel role for the Logic App. Responder is sufficient for reading incidents and adding comments (least-privilege)."
            }
        }
    },
    "variables": {
        "SentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]",
        "SentinelContributorRoleId": "ab8e14d6-4a74-4a29-9ba8-549422addade",
        "SentinelResponderRoleId": "3e150937-b8fe-4cfb-8069-0eaf05ecd056",
        "SentinelAutomationContributorRoleId": "f4c81013-99ee-4d62-a7ee-b3f1f648599a",
        "sentinelRoleDefinitionId": "[if(equals(parameters('SentinelRoleLevel'), 'Responder'), variables('SentinelResponderRoleId'), variables('SentinelContributorRoleId'))]",
        "workspaceResourceId": "[resourceId(parameters('WorkspaceResourceGroup'), 'Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]",
        "isExternalWorkspace": "[not(equals(parameters('WorkspaceResourceGroup'), resourceGroup().name))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('SentinelConnectionName')]",
            "location": "[resourceGroup().location]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('SentinelConnectionName')]",
                "api": {
                    "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', resourceGroup().location, 'azuresentinel')]"
                },
                "parameterValueType": "Alternative"
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('SentinelConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "SocradarApiKey": {
                            "type": "SecureString"
                        },
                        "SocradarIocApiKey": {
                            "type": "SecureString"
                        },
                        "CompanyId": {
                            "type": "String"
                        },
                        "RiskScoreThreshold": {
                            "type": "Int"
                        },
                        "MaxIndicators": {
                            "type": "Int"
                        }
                    },
                    "triggers": {
                        "Microsoft_Sentinel_incident": {
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "body": {
                                    "callback_url": "@{listCallbackUrl()}"
                                },
                                "path": "/incident-creation"
                            }
                        }
                    },
                    "actions": {
                        "Init_Pending": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "PendingIndicators",
                                        "type": "array",
                                        "value": []
                                    }
                                ]
                            },
                            "runAfter": {}
                        },
                        "Init_Failed": {
                            "type": "InitializeVariable",
                            "inputs": {
                                "variables": [
                                    {
                                        "name": "FailedIndicators",
                                        "type": "array",
                                        "value": []
                                    }
                                ]
                            },
                            "runAfter": {
                                "Init_Pending": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Extract_Alarm_Id": {
                            "type": "Compose",
                            "inputs": "@if(contains(coalesce(triggerBody()?['object']?['properties']?['title'], ''), '#'), first(split(last(split(coalesce(triggerBody()?['object']?['properties']?['title'], ''), '#')), ' ')), '')",
                            "runAfter": {
                                "Init_Failed": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Get_SOCRadar_Alarm_Entities": {
                            "type": "If",
                            "expression": {
                                "and": [
                                    {
                                        "not": {
                                            "equals": [
                                                "@outputs('Extract_Alarm_Id')",
                                                ""
                                            ]
                                        }
                                    },
                                    {
                                        "not": {
                                            "equals": [
                                                "@parameters('CompanyId')",
                                                ""
                                            ]
                                        }
                                    }
                                ]
                            },
                            "actions": {
                                "Fetch_Alarm": {
                                    "type": "Http",
                                    "inputs": {
                                        "method": "GET",
                                        "uri": "https://platform.socradar.com/api/company/@{parameters('CompanyId')}/incidents/v4",
                                        "queries": {
                                            "alarm_ids": "@{outputs('Extract_Alarm_Id')}"
                                        },
                                        "headers": {
                                            "API-Key": "@{parameters('SocradarApiKey')}"
                                        },
                                        "retryPolicy": {
                                            "type": "exponential",
                                            "count": 2,
                                            "interval": "PT10S",
                                            "maximumInterval": "PT1M"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    },
                                    "runAfter": {}
                                },
                                "Map_Alarm_Entities": {
                                    "type": "Select",
                                    "inputs": {
                                        "from": "@coalesce(first(body('Fetch_Alarm')?['data'])?['alarm_related_entities'], json('[]'))",
                                        "select": {
                                            "properties": {
                                                "address": "@if(equals(toLower(coalesce(item()?['key'], '')), 'ip'), item()?['value'], null)",
                                                "domainName": "@if(or(equals(toLower(coalesce(item()?['key'], '')), 'domain'), equals(toLower(coalesce(item()?['key'], '')), 'hostname')), item()?['value'], null)",
                                                "url": "@if(equals(toLower(coalesce(item()?['key'], '')), 'url'), item()?['value'], null)",
                                                "hashValue": "@if(equals(toLower(coalesce(item()?['key'], '')), 'hash'), item()?['value'], null)"
                                            }
                                        }
                                    },
                                    "runAfter": {
                                        "Fetch_Alarm": [
                                            "Succeeded",
                                            "Failed",
                                            "TimedOut"
                                        ]
                                    }
                                }
                            },
                            "else": {
                                "actions": {}
                            },
                            "runAfter": {
                                "Extract_Alarm_Id": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Build_Entity_List": {
                            "type": "Compose",
                            "inputs": "@take(union(coalesce(triggerBody()?['object']?['properties']?['relatedEntities'], json('[]')), coalesce(body('Map_Alarm_Entities'), json('[]'))), parameters('MaxIndicators'))",
                            "runAfter": {
                                "Get_SOCRadar_Alarm_Entities": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "For_Each_Entity": {
                            "type": "Foreach",
                            "foreach": "@outputs('Build_Entity_List')",
                            "runtimeConfiguration": {
                                "concurrency": {
                                    "repetitions": 1
                                }
                            },
                            "actions": {
                                "Get_Indicator_Value": {
                                    "type": "Compose",
                                    "inputs": "@coalesce(items('For_Each_Entity')?['properties']?['address'], items('For_Each_Entity')?['properties']?['domainName'], items('For_Each_Entity')?['properties']?['url'], items('For_Each_Entity')?['properties']?['hashValue'], '')",
                                    "runAfter": {}
                                },
                                "If_Indicator_Present": {
                                    "type": "If",
                                    "expression": {
                                        "and": [
                                            {
                                                "not": {
                                                    "equals": [
                                                        "@outputs('Get_Indicator_Value')",
                                                        ""
                                                    ]
                                                }
                                            }
                                        ]
                                    },
                                    "actions": {
                                        "Enrich_IOC": {
                                            "type": "Http",
                                            "inputs": {
                                                "method": "POST",
                                                "uri": "https://platform.socradar.com/api/ioc_enrichment/get/indicator_details",
                                                "headers": {
                                                    "API-Key": "@{parameters('SocradarIocApiKey')}",
                                                    "Content-Type": "application/json"
                                                },
                                                "body": {
                                                    "indicator": "@{outputs('Get_Indicator_Value')}",
                                                    "fields": [
                                                        "indicator_details"
                                                    ]
                                                },
                                                "retryPolicy": {
                                                    "type": "exponential",
                                                    "count": 3,
                                                    "interval": "PT10S",
                                                    "maximumInterval": "PT2M"
                                                }
                                            },
                                            "runtimeConfiguration": {
                                                "secureData": {
                                                    "properties": [
                                                        "inputs"
                                                    ]
                                                }
                                            },
                                            "runAfter": {}
                                        },
                                        "Handle_Response": {
                                            "type": "Switch",
                                            "expression": "@string(coalesce(outputs('Enrich_IOC')?['statusCode'], 0))",
                                            "runAfter": {
                                                "Enrich_IOC": [
                                                    "Succeeded",
                                                    "Failed",
                                                    "TimedOut"
                                                ]
                                            },
                                            "cases": {
                                                "Enriched_200": {
                                                    "case": "200",
                                                    "actions": {
                                                        "Select_ThreatActor_Names": {
                                                            "type": "Select",
                                                            "inputs": {
                                                                "from": "@coalesce(body('Enrich_IOC')?['top_classifications']?['threat_actors'], json('[]'))",
                                                                "select": "@item()?['name']"
                                                            },
                                                            "runAfter": {}
                                                        },
                                                        "Select_Malware_Names": {
                                                            "type": "Select",
                                                            "inputs": {
                                                                "from": "@coalesce(body('Enrich_IOC')?['top_classifications']?['malwares'], json('[]'))",
                                                                "select": "@item()?['name']"
                                                            },
                                                            "runAfter": {}
                                                        },
                                                        "If_Has_Signal": {
                                                            "type": "If",
                                                            "expression": {
                                                                "and": [
                                                                    {
                                                                        "greaterOrEquals": [
                                                                            "@coalesce(first(body('Enrich_IOC')?['details']?['score']), 0)",
                                                                            "@parameters('RiskScoreThreshold')"
                                                                        ]
                                                                    },
                                                                    {
                                                                        "not": {
                                                                            "and": [
                                                                                {
                                                                                    "equals": [
                                                                                        "@coalesce(body('Enrich_IOC')?['details']?['is_whitelisted'], false)",
                                                                                        true
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "equals": [
                                                                                        "@coalesce(first(body('Enrich_IOC')?['details']?['score']), 0)",
                                                                                        0
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    }
                                                                ]
                                                            },
                                                            "actions": {
                                                                "Add_Comment_to_Incident": {
                                                                    "type": "ApiConnection",
                                                                    "inputs": {
                                                                        "host": {
                                                                            "connection": {
                                                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                                                            }
                                                                        },
                                                                        "method": "post",
                                                                        "path": "/Incidents/Comment",
                                                                        "body": {
                                                                            "incidentArmId": "@triggerBody()?['object']?['id']",
                                                                            "message": "<h3>SOCRadar IOC Enrichment</h3><b>Indicator:</b> @{replace(replace(replace(coalesce(body('Enrich_IOC')?['details']?['name'], outputs('Get_Indicator_Value')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')} (@{coalesce(body('Enrich_IOC')?['details']?['object_type'], 'unknown')})<br><b>Risk Score:</b> @{coalesce(first(body('Enrich_IOC')?['details']?['score']), 0)} / 100<br><b>Signal Strength:</b> @{if(empty(string(body('Enrich_IOC')?['details']?['ioc_signal_strength'])), 'N/A', string(body('Enrich_IOC')?['details']?['ioc_signal_strength']))}<br><b>Whitelisted:</b> @{coalesce(body('Enrich_IOC')?['details']?['is_whitelisted'], false)}<br><b>Categories:</b> malware=@{coalesce(body('Enrich_IOC')?['categorization']?['malware'], false)}, threat_actor=@{coalesce(body('Enrich_IOC')?['categorization']?['threat_actor'], false)}, tor=@{coalesce(body('Enrich_IOC')?['categorization']?['tor'], false)}, vpn=@{coalesce(body('Enrich_IOC')?['categorization']?['vpn'], false)}, proxy=@{coalesce(body('Enrich_IOC')?['categorization']?['proxy'], false)}, scanner=@{coalesce(body('Enrich_IOC')?['categorization']?['scanner'], false)}<br><b>Threat Actors:</b> @{if(empty(body('Select_ThreatActor_Names')), 'None', join(body('Select_ThreatActor_Names'), ', '))}<br><b>Malware:</b> @{if(empty(body('Select_Malware_Names')), 'None', join(body('Select_Malware_Names'), ', '))}<br><b>Campaign:</b> @{if(empty(string(body('Enrich_IOC')?['top_classifications']?['campaign'])), 'N/A', string(body('Enrich_IOC')?['top_classifications']?['campaign']))}<br><b>Geo / ASN:</b> @{coalesce(body('Enrich_IOC')?['details']?['extra_info']?['city_name'], 'N/A')}, @{coalesce(body('Enrich_IOC')?['details']?['extra_info']?['region_name'], 'N/A')} (@{coalesce(body('Enrich_IOC')?['details']?['extra_info']?['asn_name'], 'N/A')})<br><b>Feed Sources:</b> @{length(coalesce(body('Enrich_IOC')?['details']?['feed_source_list'], json('[]')))}<br><b>VirusTotal:</b> @{coalesce(body('Enrich_IOC')?['details']?['vt_link'], 'N/A')}<br><i>Powered by SOCRadar IOC Enrichment</i>"
                                                                        }
                                                                    },
                                                                    "runAfter": {}
                                                                }
                                                            },
                                                            "else": {
                                                                "actions": {}
                                                            },
                                                            "runAfter": {
                                                                "Select_ThreatActor_Names": [
                                                                    "Succeeded"
                                                                ],
                                                                "Select_Malware_Names": [
                                                                    "Succeeded"
                                                                ]
                                                            }
                                                        }
                                                    }
                                                },
                                                "Pending_202": {
                                                    "case": "202",
                                                    "actions": {
                                                        "Collect_Pending": {
                                                            "type": "AppendToArrayVariable",
                                                            "inputs": {
                                                                "name": "PendingIndicators",
                                                                "value": "@outputs('Get_Indicator_Value')"
                                                            },
                                                            "runAfter": {}
                                                        }
                                                    }
                                                }
                                            },
                                            "default": {
                                                "actions": {
                                                    "Collect_Failed": {
                                                        "type": "AppendToArrayVariable",
                                                        "inputs": {
                                                            "name": "FailedIndicators",
                                                            "value": "@concat(outputs('Get_Indicator_Value'), ' (HTTP ', string(coalesce(outputs('Enrich_IOC')?['statusCode'], 0)), ')')"
                                                        },
                                                        "runAfter": {}
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "else": {
                                        "actions": {}
                                    },
                                    "runAfter": {
                                        "Get_Indicator_Value": [
                                            "Succeeded"
                                        ]
                                    }
                                }
                            },
                            "runAfter": {
                                "Build_Entity_List": [
                                    "Succeeded"
                                ]
                            }
                        },
                        "Check_Followups": {
                            "type": "If",
                            "expression": {
                                "or": [
                                    {
                                        "greater": [
                                            "@length(variables('PendingIndicators'))",
                                            0
                                        ]
                                    },
                                    {
                                        "greater": [
                                            "@length(variables('FailedIndicators'))",
                                            0
                                        ]
                                    }
                                ]
                            },
                            "actions": {
                                "Add_Summary_Comment": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                            }
                                        },
                                        "method": "post",
                                        "path": "/Incidents/Comment",
                                        "body": {
                                            "incidentArmId": "@triggerBody()?['object']?['id']",
                                            "message": "<h3>SOCRadar IOC Enrichment - summary</h3><b>Indicators submitted:</b> @{length(outputs('Build_Entity_List'))}<br><b>Awaiting first lookup:</b> @{length(variables('PendingIndicators'))}@{if(greater(length(variables('PendingIndicators')), 0), concat(' - ', join(variables('PendingIndicators'), ', ')), '')}<br><b>Not enriched:</b> @{length(variables('FailedIndicators'))}@{if(greater(length(variables('FailedIndicators')), 0), concat(' - ', join(variables('FailedIndicators'), ', ')), '')}<br>Re-run this playbook later to enrich the pending indicators.<br><i>Powered by SOCRadar IOC Enrichment</i>"
                                        }
                                    },
                                    "runAfter": {}
                                }
                            },
                            "runAfter": {
                                "For_Each_Entity": [
                                    "Succeeded",
                                    "Failed"
                                ]
                            }
                        }
                    }
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuresentinel": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('SentinelConnectionName'))]",
                                "connectionName": "[variables('SentinelConnectionName')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                },
                                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', resourceGroup().location, 'azuresentinel')]"
                            }
                        }
                    },
                    "SocradarApiKey": {
                        "value": "[parameters('SocradarApiKey')]"
                    },
                    "SocradarIocApiKey": {
                        "value": "[if(empty(parameters('SocradarIocApiKey')), parameters('SocradarApiKey'), parameters('SocradarIocApiKey'))]"
                    },
                    "CompanyId": {
                        "value": "[parameters('CompanyId')]"
                    },
                    "RiskScoreThreshold": {
                        "value": "[parameters('RiskScoreThreshold')]"
                    },
                    "MaxIndicators": {
                        "value": "[parameters('MaxIndicators')]"
                    }
                }
            }
        },
        {
            "condition": "[not(empty(parameters('SentinelServicePrincipalObjectId')))]",
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceGroup().id, parameters('PlaybookName'), variables('SentinelAutomationContributorRoleId'))]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('SentinelAutomationContributorRoleId'))]",
                "principalId": "[parameters('SentinelServicePrincipalObjectId')]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "condition": "[not(variables('isExternalWorkspace'))]",
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(variables('workspaceResourceId'), parameters('PlaybookName'), variables('sentinelRoleDefinitionId'))]",
            "scope": "[variables('workspaceResourceId')]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sentinelRoleDefinitionId'))]",
                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                "principalType": "ServicePrincipal"
            }
        },
        {
            "condition": "[variables('isExternalWorkspace')]",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2021-04-01",
            "name": "deploy-ioc-enrichment-roles",
            "resourceGroup": "[parameters('WorkspaceResourceGroup')]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
            ],
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "outer"
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "resources": [
                        {
                            "type": "Microsoft.Authorization/roleAssignments",
                            "apiVersion": "2022-04-01",
                            "name": "[guid(variables('workspaceResourceId'), parameters('PlaybookName'), variables('sentinelRoleDefinitionId'))]",
                            "scope": "[variables('workspaceResourceId')]",
                            "properties": {
                                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sentinelRoleDefinitionId'))]",
                                "principalId": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]",
                                "principalType": "ServicePrincipal"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "outputs": {
        "logicAppName": {
